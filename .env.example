# Server Configuration
PORT=3000
HOST=127.0.0.1
NODE_ENV=development

# MongoDB Atlas Connection
# Format: mongodb+srv://<username>:<password>@<cluster-url>/<dbname>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/career_evidence_coach?retryWrites=true&w=majority

# Authentication Secrets (Generate secure random 32+ character strings)
JWT_SECRET=your_jwt_secret_min_32_characters_here_change_in_production
JWT_EXPIRES_IN=7d
COOKIE_SECRET=your_cookie_signing_secret_min_32_chars_here

# Google Gemini AI Configuration
# Obtain your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
AI_MODEL=gemini-3.8-flash
AI_TIMEOUT_MS=60000

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=15
AI_RATE_LIMIT_MAX=20

# Optional / Advanced Configuration
# STORE_FILE_PATH=data/store.json # Custom file path if using fallback JSON store
# USE_LIVE_ATLAS_DB=false         # Set to true in smokeTest.js to run smoke tests against live Atlas instead of in-memory MongoDB
