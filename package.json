{
  "name": "career-evidence-portfolio-coach",
  "version": "1.0.0",
  "description": "Full-stack AI-assisted Career Evidence and Portfolio Coach for students",
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "build": "npm --prefix frontend install && npm --prefix frontend run build",
    "build:frontend": "npm --prefix frontend run build",
    "test": "node --test tests/**/*.test.js",
    "migrate": "node scripts/migrateToMongo.js --execute",
    "migrate:dry-run": "node scripts/migrateToMongo.js --dry-run",
    "claim-account": "node scripts/claimAccount.js",
    "seed": "node scripts/seed.js",
    "smoke": "node scripts/smokeTest.js",
    "check-ai": "node scripts/checkAi.js"
  },
  "keywords": [
    "career",
    "portfolio",
    "evidence",
    "coaching",
    "capstone",
    "gemini",
    "express"
  ],
  "author": "CSE Capstone Team",
  "license": "ISC",
  "dependencies": {
    "@google/genai": "^2.30.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.4"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.3.0"
  }
}
