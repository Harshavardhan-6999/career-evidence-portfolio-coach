# Node dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment and secrets (Exclude all real env files, allow only .env.example)
.env
.env.*
.env.local
.env.*.local
*.env
*.pem
*.key
!.env.example

# Frontend specific exclusions
frontend/node_modules/
frontend/dist/
frontend/.env
frontend/.env.*
frontend/.env.local
!frontend/.env.example

# Database backups and temporary files
data/backups/
data/*.tmp.*
data/*.tmp
tests/fixtures/*.tmp.*
tests/fixtures/*.tmp

# Build outputs
dist/

# Test coverage
coverage/

# Operating System files
Thumbs.db
.DS_Store

# Logs
logs/
*.log
